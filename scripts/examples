#!/usr/bin/env bash

# Runs every example against the mock server with fake credentials. It fails when the
# mock can't start, when there are no examples, or when a file that looks like an example
# isn't one this script runs. Each example must succeed, reach the mock, and get no 4xx
# or 5xx. The last line of stdout names the examples that ran.

set -euo pipefail

cd "$(dirname "$0")/.."

exec node --input-type=commonjs - <<'RUN_EXAMPLES'
const { spawn, spawnSync } = require('node:child_process');
const fs = require('node:fs');
const net = require('node:net');
const path = require('node:path');

const EXAMPLE_TIMEOUT_MS = 5 * 60 * 1000;
const MOCK_START_TIMEOUT_MS = 2 * 60 * 1000;
const MOCK_LOG_WAIT_MS = 5 * 1000;
const STOP_WAIT_MS = 5 * 1000;
const REQUEST_LINE = /\b(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(\S+)\s+→\s+(\d{3})\b/;
const ENV_NAME = /['"]([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+)['"]/g;

const entries = (directory) =>
  fs.existsSync(directory) ? fs.readdirSync(directory, { withFileTypes: true }) : [];
const filesIn = (directory, pattern) =>
  entries(directory)
    .filter((entry) => entry.isFile() && pattern.test(entry.name))
    .map((entry) => path.join(directory, entry.name));
const directoriesWith = (directory, pattern) =>
  entries(directory)
    .filter((entry) => entry.isDirectory())
    .map((entry) => path.join(directory, entry.name))
    .filter((candidate) => filesIn(candidate, pattern).length > 0);
const walk = (target) =>
  fs.statSync(target).isDirectory()
    ? entries(target).flatMap((entry) => walk(path.join(target, entry.name)))
    : [target];
const sourcesUnder = (directory, pattern) =>
  (fs.existsSync(directory) ? walk(directory) : []).filter((file) => pattern.test(path.basename(file)));

const exampleSources = () => sourcesUnder('examples', /\.go$/);
const discover = () =>
  directoriesWith('examples', /\.go$/).map((source) => ({
    name: source,
    source,
    command: ['go', 'run', `./${source}`],
  }));

const refuse = (message) => {
  console.error(`==> ${message}`);
  process.exit(1);
};

if (!fs.existsSync('scripts/mock')) refuse('scripts/mock is missing, so no example can run');
const examples = discover();
if (examples.length === 0) refuse('No examples found, so nothing would be tested');
const runsFile = (file) =>
  examples.some(({ source }) => file === source || file.startsWith(`${source}${path.sep}`));
const stranded = exampleSources().filter((file) => !runsFile(file));
if (stranded.length > 0) {
  refuse(`These look like examples, but this script doesn't run them:\n  ${stranded.join('\n  ')}`);
}

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const signalGroup = (child, signal) => {
  try {
    process.kill(-child.pid, signal);
    return true;
  } catch {
    return false;
  }
};
const stopGroup = async (child) => {
  if (!signalGroup(child, 'SIGTERM')) return;
  const deadline = Date.now() + STOP_WAIT_MS;
  while (Date.now() < deadline) {
    if (!signalGroup(child, 0)) return;
    await sleep(100);
  }
  signalGroup(child, 'SIGKILL');
};

const portIsOpen = (port) =>
  new Promise((resolve) => {
    const socket = net.connect({ host: '127.0.0.1', port });
    socket.once('connect', () => {
      socket.destroy();
      resolve(true);
    });
    socket.once('error', () => resolve(false));
  });

const freePort = () =>
  new Promise((resolve, reject) => {
    const server = net.createServer();
    server.once('error', reject);
    server.listen(0, '127.0.0.1', () => {
      const { port } = server.address();
      server.close(() => resolve(port));
    });
  });

// A mock this script didn't start would answer the examples without the log showing it.
const choosePort = async () => {
  const pinned = process.env.STAINLESS_MOCK_PORT;
  if (!pinned) return freePort();
  if (await portIsOpen(Number(pinned))) {
    throw new Error(`Port ${pinned} is already in use; stop that server or unset STAINLESS_MOCK_PORT`);
  }
  return Number(pinned);
};

// Each runs in its own process group, so stopping them can't reach anything else.
let mock;
let runningExample;
const stopEverything = async () => {
  if (runningExample) await stopGroup(runningExample);
  if (mock) await stopGroup(mock);
};
for (const [signal, code] of [['SIGINT', 130], ['SIGTERM', 143]]) {
  process.once(signal, () => stopEverything().finally(() => process.exit(code)));
}

const startMock = async (port, requests) => {
  const child = spawn('./scripts/mock', [], {
    detached: true,
    env: { ...process.env, STAINLESS_MOCK_PORT: String(port) },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  mock = child;
  let exited = false;
  child.once('error', () => {
    exited = true;
  });
  child.once('close', () => {
    exited = true;
  });
  let log = '';
  let partial = '';
  const onOutput = (chunk) => {
    const text = chunk.toString();
    log += text;
    const lines = (partial + text).split('\n');
    partial = lines.pop();
    for (const line of lines) {
      const match = line.match(REQUEST_LINE);
      if (match && !match[2].startsWith('/_x-steady')) {
        requests.push({ method: match[1], route: match[2], status: Number(match[3]) });
      }
    }
  };
  child.stdout.on('data', onOutput);
  child.stderr.on('data', onOutput);

  const deadline = Date.now() + MOCK_START_TIMEOUT_MS;
  while (Date.now() < deadline && !exited) {
    try {
      const response = await fetch(`http://127.0.0.1:${port}/_x-steady/health`);
      if (response.ok) return;
    } catch {
      // Not listening yet.
    }
    await sleep(200);
  }
  throw new Error(`The mock server did not start on port ${port}:\n${log}`);
};

const environmentFor = (mockUrl) => {
  const names = new Set(["OURS_PRIVACY_PLATFORM_BASE_URL","OURS_PRIVACY_API_KEY"]);
  for (const example of examples) {
    for (const file of walk(example.source)) {
      for (const match of fs.readFileSync(file, 'utf8').matchAll(ENV_NAME)) names.add(match[1]);
    }
  }
  const environment = { ...process.env };
  for (const name of ['HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'http_proxy', 'https_proxy', 'all_proxy']) {
    delete environment[name];
  }
  for (const name of names) {
    environment[name] = name.includes('BASE_URL') ? mockUrl : `fake-example-value-${name.toLowerCase()}`;
  }
  return environment;
};

const runExample = (example, env) =>
  new Promise((resolve) => {
    const [command, ...args] = example.command;
    const child = spawn(command, args, { detached: true, env, stdio: ['ignore', 'inherit', 'inherit'] });
    runningExample = child;
    let timedOut = false;
    const timer = setTimeout(() => {
      timedOut = true;
      stopGroup(child);
    }, EXAMPLE_TIMEOUT_MS);
    child.once('error', (error) => {
      clearTimeout(timer);
      resolve({ error: error.message });
    });
    child.once('close', (code, signal) => {
      clearTimeout(timer);
      runningExample = undefined;
      if (timedOut) return resolve({ error: `timed out after ${EXAMPLE_TIMEOUT_MS / 1000}s` });
      return resolve(signal ? { error: `killed by ${signal}` } : { code });
    });
  });

// The mock logs asynchronously, and later than usual on a busy machine.
const requestsSince = async (requests, before) => {
  await sleep(300);
  const deadline = Date.now() + MOCK_LOG_WAIT_MS;
  while (requests.length === before && Date.now() < deadline) await sleep(100);
  return requests.slice(before);
};

const treeStatus = () => {
  const status = spawnSync('git', ['status', '--porcelain', '--untracked-files=all'], { encoding: 'utf8' });
  return status.status === 0 ? status.stdout : undefined;
};

const main = async () => {
  const requests = [];
  const treeBefore = treeStatus();
  const port = await choosePort();
  await startMock(port, requests);
  const env = environmentFor(`http://127.0.0.1:${port}`);
  const failures = [];
  const ran = [];
  for (const example of examples) {
    console.log(`==> ${example.name}`);
    const before = requests.length;
    const result = await runExample(example, env);
    ran.push(example.name);
    const seen = await requestsSince(requests, before);
    for (const request of seen) console.log(`    ${request.method} ${request.route} -> ${request.status}`);
    const rejected = seen.filter((request) => request.status >= 400);
    if (result.error) failures.push(`${example.name}: ${result.error}`);
    else if (result.code !== 0) failures.push(`${example.name}: exited ${result.code}`);
    if (seen.length === 0) failures.push(`${example.name}: the mock server saw no requests`);
    for (const request of rejected) {
      failures.push(`${example.name}: ${request.method} ${request.route} returned ${request.status}`);
    }
  }
  await stopEverything();
  const treeAfter = treeStatus();
  if (treeBefore !== treeAfter) failures.push(`the examples changed the tree:\n${treeAfter}`);
  console.log(`==> Ran ${ran.length} example(s) against the mock server`);
  if (failures.length > 0) {
    console.error(`\n${failures.length} example failure(s):`);
    for (const failure of failures) console.error(`  ${failure}`);
    process.exit(1);
  }
  console.log(`EXAMPLES_RAN ${JSON.stringify(ran)}`);
  process.exit(0);
};

main().catch(async (error) => {
  console.error(error.message);
  await stopEverything();
  process.exit(1);
});
RUN_EXAMPLES
